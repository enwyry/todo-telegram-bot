{
  "name": "todo-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for managing a personal todo list",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.ts",
    "dev": "node --watch --env-file-if-exists=.env src/bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "node test/flows.mjs"
  },
  "dependencies": {
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
